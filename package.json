{
  "name": "discrete-pid-eval",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows-local discrete control loop response and PID evaluation backend (API + CLI + fixtures + tests).",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node --no-warnings dist/src/api/server.js",
    "serve": "npm run build && node --no-warnings dist/src/api/server.js",
    "stop": "node --no-warnings dist/scripts/stop.js",
    "demo": "npm run build && node --no-warnings dist/scripts/demo.js",
    "cli": "npm run build && node --no-warnings dist/src/cli/cli.js",
    "test": "npm run build && node --no-warnings --test --test-concurrency=1 \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.7.0"
  }
}
